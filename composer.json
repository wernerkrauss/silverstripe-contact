{
    "name": "wernerkrauss/silverstripe-contact",
    "description": "Simple contact module for Silverstripe CMS",
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "require": {
        "silverstripe/framework": "^5 || ^6",
        "silverstripe/cms": "^5 || ^6",
        "silverstripe/htmleditor-tinymce": "^1",
        "dnadesign/silverstripe-elemental": "^5 || ^6",
        "silverstripe/spamprotection": "^4 || ^5"
    },
    "suggest": {
        "innoweb/silverstripe-spamprotection-honeypot": "Honeypot spam protector (SS6: ^3) — set as default_spam_protector to activate enableSpamProtection() on the contact form."
    },
    "autoload": {
        "psr-4": {
            "Netwerkstatt\\Contact\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netwerkstatt\\Contact\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^4",
        "phpunit/phpunit": "^11.3"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
